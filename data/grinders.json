  "selfCalibration": {
    "title": "Mühle selbst kalibrieren",
    "purpose": "micronPerStep bestimmen, ohne Sieb und ohne Herstellerangabe",
    "formulaRef": "F-22",
    "estimatedEspressoMicron": 300,
    "steps": [
      {
        "index": 1,
        "instruction": "Eine Bohne fixieren: gleiche Tüte, gleicher Röstgrad, Altersunterschied < 3 Tage"
      },
      {
        "index": 2,
        "instruction": "Rezept fixieren: 18 g in, 36 g out, gleiche Temperatur, gleiche Puck-Prep"
      },
      {
        "index": 3,
        "instruction": "Shot bei Einstellung S1 ziehen, Zeit t1 notieren"
      },
      {
        "index": 4,
        "instruction": "4 Schritte gröber stellen → S2, Shot ziehen, Zeit t2 notieren"
      },
      {
        "index": 5,
        "instruction": "Auswerten",
        "calc": "ratio = sqrt(t1/t2); deltaMicron = 300 * (ratio - 1); micronPerStep = deltaMicron / 4"
      }
    ],
    "preconditions": [
      "Beide Shots ohne Channeling (flowState in normal/slow/fast)",
      "Gleiche Bohne, Altersunterschied < 3 Tage",
      "Identische Dosis (±0,2 g)"
    ],
    "example": {
      "t1": 34,
      "t2": 24,
      "ratio": 1.19,
      "deltaMicron": 57,
      "micronPerStep": 14.3
    }
  },
  "transfer": {
    "formula": "micronA = grinderA.zeroPointOffsetMicron + settingA * grinderA.micronPerStep; settingB = (micronA - grinderB.zeroPointOffsetMicron) / grinderB.micronPerStep",
    "confidence": "low",
    "displayAs": "Toleranzband ±2 Schritte, nicht als exakte Zahl",
    "note": "Unterschiedliche Mahlwerksgeometrien erzeugen bei gleichem Median verschiedene Verteilungen."
